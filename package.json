{
  "name": "cinemate-monorepo",
  "version": "1.0.0",
  "description": "Cinemate - AI-Powered Movie Discovery & Recommendation Platform",
  "main": "server/src/server.js",
  "private": true,
  "scripts": {
    "build": "npm --prefix Cinemate-main/cinema-main install && npm --prefix Cinemate-main/cinema-main run build && npm --prefix server install",
    "start": "node server/src/server.js",
    "server:start": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client:start": "cd Cinemate-main/cinema-main && npm start",
    "test": "cd server && npm test",
    "benchmark:cache": "node tests/load/search-cache-benchmark.js",
    "benchmark:ratelimit": "node tests/load/rate-limit-test.js",
    "benchmark:recs": "node tests/load/recommendation-benchmark.js",
    "benchmark:ai": "node evaluation/evaluate-search.js"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
